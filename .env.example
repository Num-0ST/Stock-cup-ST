# copy to .env and fill in real values before `docker compose up -d --build`
DB_NAME=wms
DB_USER=wms
DB_PASSWORD=
SECRET_KEY=
ADMIN_PASSWORD=
API_PORT=8000
# backups (optional)
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14
TZ=Asia/Bangkok
# bill scanning from photos (optional): key from https://console.anthropic.com
ANTHROPIC_API_KEY=
BILL_AI_MODEL=claude-sonnet-5-5
