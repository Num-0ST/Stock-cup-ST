# copy to .env and fill in real values before `docker compose up -d --build`
DB_NAME=wms
DB_USER=wms
DB_PASSWORD=
SECRET_KEY=
ADMIN_PASSWORD=
API_PORT=8000
# backups (optional)
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14
TZ=Asia/Bangkok
# bill scanning from photos: free OCR on this server by default (printed bills).
# Lao bills: BILL_OCR_LANGS=tha+lao+eng
BILL_OCR_ENGINE=auto
BILL_OCR_LANGS=tha+eng
# optional paid AI reading (better for handwriting): key from https://console.anthropic.com
# with a key and BILL_OCR_ENGINE=auto the AI is used; set BILL_OCR_ENGINE=tesseract to stay free
ANTHROPIC_API_KEY=
BILL_AI_MODEL=claude-sonnet-5-5
# housekeeping: raw Excel rows of finished imports are removed after this many days (0 = keep forever)
IMPORT_ROWS_KEEP_DAYS=180
# Cloudflare named tunnel token (only for: docker compose --profile tunnel up -d)
TUNNEL_TOKEN=
